---
// One page per Markdown post in src/posts/. Drafts get a page in dev only
// (the /thinking index shows them muted there), so a draft can never ship.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WritingSample from '../../components/WritingSample.astro';
import { getPosts, type Post } from '../../content/thinking';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts
    .filter((post) => !import.meta.env.PROD || post.status === 'published')
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: Post };

const { post } = Astro.props;
const { Content } = await render(post.entry);
---

<Base type="article" title={post.pageTitle} description={post.description}>
  <WritingSample post={post}>
    <Content />
  </WritingSample>
</Base>

---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Rule from '../components/Rule.astro';
import { site } from '../config/site';
import { contact } from '../content/contact';
import { tieDashes } from '../utils/typography';

const emailHref = site.email && site.email.length > 0 ? `mailto:${site.email}` : null;

// The book sets its closing thoughts one sentence per line.
const signatureLines = contact.signature.split(/(?<=\.)\s+/);
---

<Base title="Contact" description={contact.description} footerEthos={false}>
  <section class="contact shell" aria-labelledby="contact-heading">
    <div class="contact__main">
      <SectionHeading
        as="h1"
        id="contact-heading"
        label={contact.label}
        title={contact.heading}
        size="display"
      />

      <p class="lead quiet contact__body">{tieDashes(contact.body)}</p>

      <div class="contact__actions">
        <a
          href={site.linkedin}
          class="btn btn--primary"
          target="_blank"
          rel="noreferrer noopener"
        >
          {contact.linkedin.label}
          <span class="btn__arrow" aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>

        {emailHref && (
          <a href={emailHref} class="btn btn--ghost">
            {contact.email.label}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>

    <div class="contact__ethos">
      <p class="h3 contact__signature">
        {signatureLines.map((line) => <span>{line} </span>)}
      </p>
      <Rule tone="amber" class="contact__rule" />
    </div>
  </section>
</Base>

<style>
  /*
   * Composed after the book's closing page (hp14): the invitation at the
   * outer margin, the ethos lower in the right half on an amber rule — the
   * diagonal the book uses to close.
   */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 7rem) clamp(1rem, 0.5rem + 2vw, 3rem);
  }

  .contact__main {
    display: flex;
    flex-direction: column;
  }

  .contact__body {
    max-width: 30rem;
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }

  .contact__ethos {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    margin-top: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .contact__signature span {
    display: block;
    text-wrap: balance;
  }

  .contact__ethos :global(.contact__rule) {
    max-width: 30rem;
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
      /* Fill the first screen so the spread reads whole; the footer's own
         closing follows below the fold. */
      min-height: clamp(36rem, calc(90svh - var(--header-h)), 58rem);
    }

    .contact__main {
      grid-column: 1;
      grid-row: 1;
    }

    /* Spans both rows and rests on the bottom edge: on a tall screen it
       drops well below the invitation (the book's diagonal); on a short
       one it rises beside it, so the rule never falls under the fold. */
    .contact__ethos {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      margin-top: 0;
      padding-bottom: clamp(2rem, 1rem + 3vw, 4.5rem);
    }

    .contact__ethos :global(.contact__rule) {
      max-width: 36rem;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Rule from '../../components/Rule.astro';
import BuildEntry from '../../components/builds/BuildEntry.astro';
import { site } from '../../config/site';
import { builds, buildsPage, type Build } from '../../content/builds';

// External links render only when the URL exists in site.ts — never invented.
const resolveHref = (key: Build['hrefKey']): string | undefined => {
  if (!key) return undefined;
  const value = site[key];
  return value && value.length > 0 ? value : undefined;
};

const sourceHrefFor = (build: Build): string | undefined =>
  site.github && build.slug !== 'ssc-hrbp-coe' ? site.github : undefined;
---

<Base title="Builds" description={buildsPage.description}>
  <section class="builds shell" aria-labelledby="builds-heading">
    <div class="builds__opening">
      <SectionHeading
        as="h1"
        id="builds-heading"
        label={buildsPage.label}
        title={buildsPage.title}
      />
      <p class="lead quiet builds__intro">{buildsPage.intro}</p>
    </div>

    <div class="builds__list">
      {builds.map((build) => (
        <BuildEntry
          build={build}
          href={resolveHref(build.hrefKey)}
          sourceHref={sourceHrefFor(build)}
        />
      ))}
    </div>

    <div class="builds__close">
      <p class="h3 builds__framing">
        {buildsPage.framing.map((line) => <span>{line} </span>)}
      </p>
      <Rule tone="amber" class="builds__rule" />
    </div>
  </section>
</Base>

<style>
  /*
   * Composed after the book's Statement spread (hp03): title at the outer
   * margin, copy on a second axis ≈ 26% in. Every block on the page shares
   * that axis on desktop so the list reads as one editorial column.
   */
  .builds {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 7rem) 0;
  }

  .builds__opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2rem, 1.5rem + 2.5vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 7rem);
  }

  .builds__opening :global(.section-heading h1) {
    max-width: 13ch;
  }

  .builds__intro {
    max-width: 38rem;
  }

  .builds__list {
    border-bottom: 1px solid var(--color-hairline);
  }

  .builds__close {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-top: clamp(4rem, 3rem + 4vw, 8rem);
  }

  .builds__framing {
    max-width: 36ch;
  }

  .builds__framing span {
    display: block;
    text-wrap: balance;
  }

  /* Phones: balance splits "The judgment behind it" into a jagged
     long/short/long block; pretty keeps the phrase together. */
  @media (max-width: 29.99rem) {
    .builds__framing span {
      text-wrap: pretty;
    }
  }

  .builds__close :global(.builds__rule) {
    max-width: 30rem;
  }

  @media (min-width: 64rem) {
    .builds__opening,
    .builds__close {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--grid-gap);
    }

    .builds__opening :global(.section-heading) {
      grid-column: 1 / -1;
    }

    .builds__intro,
    .builds__framing,
    .builds__close :global(.builds__rule) {
      grid-column: 2;
    }
  }
</style>

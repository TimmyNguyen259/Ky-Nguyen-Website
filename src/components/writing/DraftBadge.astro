---
// Dev-only marker on unpublished rows (drafts are filtered out of prod builds
// before they reach this component). The global .label type in a hairline pill.
---

<span class="label draft-badge">Draft</span>

<style>
  .draft-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
  }
</style>
